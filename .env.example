# Valores usados por `npm run config` (scripts/set-env.mjs). Ver docs/DESPLIEGUE-AWS-AZURE.md
ENTRA_TENANT_ID=<Directory (tenant) ID>
ENTRA_SPA_CLIENT_ID=<Application (client) ID del registro SPA>
ENTRA_API_CLIENT_ID=<Application (client) ID del registro API/BFF>
# Vacío en local (proxy /api); en AWS: https://<id>.execute-api.<region>.amazonaws.com
API_BASE_URL=
